from __future__ import annotations

from collections.abc import Callable
from typing import Any

import numpy as np
import numpy.typing as npt

class ConversionReport:
    @property
    def representation(self) -> str: ...
    @property
    def dtype(self) -> str: ...
    @property
    def shape(self) -> tuple[int, int]: ...
    @property
    def copied(self) -> bool: ...
    @property
    def zero_copy(self) -> bool: ...
    @property
    def densified(self) -> bool: ...
    @property
    def arrow_zero_copy(self) -> bool: ...
    @property
    def cast(self) -> bool: ...
    @property
    def converted_from(self) -> str | None: ...
    @property
    def eager_fallback(self) -> str | None: ...
    @property
    def batches(self) -> int: ...
    @property
    def partitions(self) -> int: ...
    @property
    def partition_sizes(self) -> list[int]: ...
    @property
    def feature_names(self) -> list[str]: ...
    @property
    def data_pointer(self) -> int | None: ...
    @property
    def indices_pointer(self) -> int | None: ...
    @property
    def indptr_pointer(self) -> int | None: ...
    @property
    def stored_zeros(self) -> int: ...
    @property
    def label_table(self) -> list[str] | None: ...
    @property
    def abi_dense_required(self) -> bool: ...
    @property
    def missing_policy(self) -> str: ...

def describe(
    dataset: Any,
    *,
    target: str | None = None,
    columns: list[str] | None = None,
    on_missing: str = "reject",
    fill_value: float | None = None,
    dtype: str | npt.DTypeLike | None = None,
) -> ConversionReport: ...
def supported_representations() -> list[str]: ...
def map_in_arrow(
    dataframe: Any,
    function: Callable[[Any], Any],
    *,
    schema: Any,
    batch_size: int = ...,
) -> Any: ...

SPARK_DRIVER_BATCH_SIZE: int

__all__: list[str]
